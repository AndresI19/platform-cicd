# The runner's credentials. A PAT and a cluster token; neither has any business in git.
runner/.env

# The FVT runner's credential (FVT_CODE). Same rule.
fvt/.env

# E2E run output and its browser downloads — regenerated by every run, and the
# browsers alone are ~650M.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.pw-browsers/
